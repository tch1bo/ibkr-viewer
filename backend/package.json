{
  "name": "ibkr-viewer-backend",
  "version": "1.0.0",
  "description": "Backend API proxy for IBKR Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run generate-types",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "generate-types": "openapi-typescript https://api.ibkr.com/gw/api/v3/api-docs -o src/types/ibkr-openapi.ts && node -e \"const fs=require('fs');const f='src/types/ibkr-openapi.ts';fs.writeFileSync(f,'// @ts-nocheck\\n'+fs.readFileSync(f,'utf8'))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "openapi-typescript": "^6.7.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
